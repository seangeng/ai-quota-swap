/* ai-quota-swap TUI — flat, low-chrome layout.
   Colors come from the registered "qswap-dark" / "qswap-light" themes
   (theme.py); this file only handles layout, spacing, and component states. */

Screen {
    background: $background;
}

/* Scrollbars: a quiet thumb on the background, never a solid black track. */
* {
    scrollbar-background: $background;
    scrollbar-background-hover: $background;
    scrollbar-background-active: $background;
    scrollbar-color: $panel;
    scrollbar-color-hover: $secondary;
    scrollbar-color-active: $secondary;
    scrollbar-corner-color: $background;
    scrollbar-size-vertical: 1;
}

/* -- dashboard ------------------------------------------------------------------ */

#cost-line {
    height: 1;
    padding: 0 2;
    color: $secondary;
    display: none;
}

#accounts-panel {
    height: auto;
    padding: 1 2;
    background: $background;
}

#menu-title {
    height: 1;
    padding: 0 2;
    color: $secondary;
}

#menu {
    height: auto;
    background: $background;
    padding: 0 1 0 0;
}

#accounts {
    background: $background;
    padding: 0 1 0 0;
}

#menu:focus, #accounts:focus {
    background-tint: $foreground 0%;
}

#menu ListItem, #accounts ListItem {
    background: transparent;
    padding: 0 1;
    border-left: thick $background;
}

#accounts ListItem {
    margin-bottom: 1;
}

#accounts ListItem.heading-item {
    margin-bottom: 0;
}

#menu ListItem.-highlight,
#menu:focus ListItem.-highlight,
#accounts ListItem.-highlight,
#accounts:focus ListItem.-highlight {
    color: $foreground;
    background: $surface;
    text-style: none;
    border-left: thick $primary;
}

#accounts ListItem.flash {
    background: $panel;
}

/* A heading inside a list: the cursor passes over it; it is not "disabled". */
ListItem:disabled {
    text-opacity: 100%;
    opacity: 100%;
}

MenuItem Static { color: $foreground; }
MenuItem Static.menu-item-muted { color: $secondary; }
MenuItem Static.menu-heading { color: $secondary; text-style: bold; }
Static.list-heading { color: $foreground; text-style: bold; }

/* -- switch / watch screens --------------------------------------------------- */

#list-title {
    height: 1;
    margin: 1 0;
    padding: 0 2;
    color: $secondary;
}

/* -- auto screen ---------------------------------------------------------- */

#auto-tabs {
    height: 1;
    margin-top: 1;
    padding: 0 2;
}

#auto-panels {
    height: auto;
}

.engine-panel {
    height: auto;
    width: 1fr;
    padding: 0 0 1 0;
    border-left: blank;
}

.engine-panel.selected {
    border-left: thick $primary;
}

.engine-panel AccountsPanel {
    height: auto;
    padding: 1 2 0 2;
    background: $background;
}

.auto-title-row {
    height: 1;
    margin: 1 0 1 2;
}

.mode-badge {
    width: auto;
    text-style: bold;
}

.mode-badge.dry {
    background: $panel;
    color: $warning;
}

.mode-badge.live {
    background: $primary;
    color: $background;
}

.auto-summary {
    width: 1fr;
    color: $secondary;
    padding-left: 2;
}

.candidates {
    height: auto;
    padding: 0 2;
}

#event-log {
    overflow-x: hidden;
    background: $background;
    border-top: solid $panel;
    padding: 0 1;
}

/* -- usage screen ------------------------------------------------------------ */

#usage-title {
    height: 1;
    margin: 1 0;
    padding: 0 2;
}

#usage-body {
    padding: 0 2;
}

/* -- modals ----------------------------------------------------------------- */

ConfirmModal, AddTokenModal, OutputModal, CommandModal {
    align: center middle;
    background: $background 60%;
}

.modal-box {
    width: 64;
    max-width: 90%;
    height: auto;
    max-height: 90%;
    background: $surface;
    border: round $panel;
    padding: 1 2;
}

.modal-box-wide {
    width: 90;
}

.modal-title {
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
}

.modal-body {
    color: $foreground;
    margin-bottom: 1;
}

.modal-command {
    color: $foreground;
    background: $background;
    padding: 0 1;
    text-style: bold;
}

.modal-buttons {
    height: auto;
    align-horizontal: right;
    margin-top: 1;
}

/* Flat chip buttons: quiet at rest, terracotta block when focused. ←/→ move
   focus between them, Enter presses — the accent shows where Enter lands. */
.modal-buttons Button {
    border: none;
    height: 1;
    min-width: 12;
    padding: 0 2;
    margin-left: 2;
    background: $panel;
    color: $foreground;
    text-style: none;
}

.modal-buttons Button:hover {
    background: $panel-lighten-1;
}

.modal-buttons Button:focus {
    background: $primary;
    color: $background;
    text-style: bold;
}

.modal-hint {
    height: 1;
    margin-top: 1;
    color: $secondary;
}

.modal-output {
    height: auto;
    max-height: 20;
    background: $background;
    padding: 1;
}

.form-error {
    height: 1;
    color: $error;
}

AddTokenModal Input {
    margin-bottom: 1;
}
